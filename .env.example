# videokit configuration. Copy to .env and adjust.
# See specs/001-videokit-youtube-prep/contracts/configuration.md

# docker compose only (not read by the app): run as this user; set to `id -u` / `id -g`
PUID=1000
PGID=1000

DATA_DIR=/data
PORT=8000
MAX_UPLOAD_GB=10
JOB_TTL_HOURS=24
MAX_FRAMES=80
FRAME_WIDTH=768

# Transcription: ordered, comma-separated (openai). Required; there is no default.
TRANSCRIBE_PROVIDERS=openai
# Model sent to OpenAI or to your server (e.g. Systran/faster-whisper-large-v3 for speaches)
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Optional self-hosted OpenAI-compatible transcription server, with its /v1 prefix
# (empty = OpenAI's API); must start with http:// or https://
# OPENAI_TRANSCRIBE_URL=http://host.docker.internal:8000/v1
# Optional transcription key (used instead of OPENAI_API_KEY; the only key sent to a self-hosted server)
# OPENAI_TRANSCRIBE_API_KEY=<your-transcription-api-key>

# LLM: ordered, comma-separated (anthropic, openai)
LLM_PROVIDERS=anthropic
ANTHROPIC_API_KEY=<your-anthropic-api-key>
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high
ANTHROPIC_EFFORT=medium

# Required if openai is in LLM_PROVIDERS, or for OpenAI transcription without OPENAI_TRANSCRIBE_API_KEY
OPENAI_API_KEY=<your-openai-api-key>
# Required if openai is in LLM_PROVIDERS (no default)
OPENAI_MODEL=<your-openai-model-id>

# Video Generation: ordered, comma-separated (omni). Empty hides the tool.
VIDEO_PROVIDERS=
# Required if omni is listed: a Google AI Studio key from a project with billing enabled
GEMINI_API_KEY=<your-api-key>
OMNI_MODEL=gemini-omni-1.1-flash

# Optional JSON, $/MTok:
# PRICING_OVERRIDES={"<model>": {"input": 4.0, "output": 20.0, "cache_read": 0.2, "cache_write": 5.0, "video_output": 17.5}}

LOG_LEVEL=INFO
