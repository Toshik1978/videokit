# videokit configuration. Copy to .env and adjust.
# See specs/001-videokit-youtube-prep/contracts/configuration.md

# docker compose only (not read by the app): run as this user; set to `id -u` / `id -g`
PUID=1000
PGID=1000

DATA_DIR=/data
PORT=8000
MAX_UPLOAD_GB=10
JOB_TTL_HOURS=24
MAX_FRAMES=80
FRAME_WIDTH=768

# Transcription: ordered, comma-separated (local, openai)
TRANSCRIBE_PROVIDERS=local
WHISPER_MODEL=large-v3-turbo
# auto | cuda | cpu
WHISPER_DEVICE=auto
OPENAI_TRANSCRIBE_MODEL=whisper-1

# LLM: ordered, comma-separated (anthropic, openai)
LLM_PROVIDERS=anthropic
ANTHROPIC_API_KEY=<your-anthropic-api-key>
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high
ANTHROPIC_EFFORT=medium

# Required if any openai provider is listed
OPENAI_API_KEY=<your-openai-api-key>
# Required if openai is in LLM_PROVIDERS (no default)
OPENAI_MODEL=<your-openai-model-id>

# Video Generation: ordered, comma-separated (omni). Empty hides the tool.
VIDEO_PROVIDERS=
# Required if omni is listed: a Google AI Studio key from a project with billing enabled
GEMINI_API_KEY=<your-api-key>
OMNI_MODEL=gemini-omni-1.1-flash

# Optional JSON, $/MTok:
# PRICING_OVERRIDES={"<model>": {"input": 4.0, "output": 20.0, "cache_read": 0.2, "cache_write": 5.0, "video_output": 17.5}}

LOG_LEVEL=INFO
